+function loadCourtMartialReports() {
+  try {
+    if (typeof window.COURT_MARTIAL_REPORTS === 'undefined' || !Array.isArray(window.COURT_MARTIAL_REPORTS)) {
+      console.warn('COURT_MARTIAL_REPORTS data not found or invalid');
