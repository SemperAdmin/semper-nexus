{
  "name": "semper-nexus",
  "version": "2.0.0",
  "description": "Semper Nexus - Monitor military directives, messages, and publications",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch-fa": "node scripts/fetch-fa-checklists.mjs",
    "fetch-cmr": "node scripts/fetch-court-martial.mjs",
    "fetch-secnav": "node scripts/fetch-secnav.mjs",
    "fetch-alnav": "node scripts/fetch-alnav.mjs",
    "generate-secnav": "node scripts/generate-secnav-data.mjs",
    "generate-alnav": "node scripts/generate-alnav-data.mjs",
    "generate-static": "npm run generate-secnav && npm run generate-alnav",
    "fetch-static": "npm run fetch-fa && npm run generate-secnav && npm run generate-alnav",
    "fetch-all": "npm run fetch-static",
    "update-data": "npm run generate-static",
    "update-vendor": "node -e \"const fs=require('fs');fs.mkdirSync('vendor',{recursive:true});fs.copyFileSync('node_modules/dompurify/dist/purify.min.js','vendor/purify.min.js');fs.copyFileSync('node_modules/web-vitals/dist/web-vitals.iife.js','vendor/web-vitals.iife.js');console.log('vendor/ refreshed from node_modules');\"",
    "lint": "eslint app.js --fix",
    "format": "prettier --write \"*.{js,html,css,md}\"",
    "format:check": "prettier --check \"*.{js,html,css,md}\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "cheerio": "^1.1.2",
    "dompurify": "^3.4.11",
    "web-vitals": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "terser": "^5.49.2",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/furby203824/Nexus.git"
  },
  "author": "Nexus",
  "license": "MIT"
}
